{
  "name": "ssomicroservice",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest -i --runInBand",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "start": "nodemon server.js",
    "dev": "concurrently -n server,client -c blue,green \"nodemon server.js\" \"npm run dev --prefix client\"",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "npx sequelize-cli db:migrate:status --config src/config/database.js --migrations-path src/database/migrations",
    "migrate:undo": "npx sequelize-cli db:migrate:undo --config src/config/database.js --migrations-path src/database/migrations",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all --config src/config/database.js --migrations-path src/database/migrations",
    "deploy": "firebase deploy"
  },
  "engines": {
    "node": "22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.1.1",
    "helmet": "^8.1.0",
    "nodemon": "^3.1.14",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.5"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/zdna-functions/",
      "<rootDir>/sso_Integration/",
      "<rootDir>/vdi-reference/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/docs/**",
      "!src/database/**",
      "!src/config/**",
      "!src/data/**",
      "!src/mock/**",
      "!src/**/firestoreSSO.service.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 60,
        "statements": 70
      }
    }
  }
}
