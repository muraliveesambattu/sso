# ── ZDNA SSO Microservice — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env — it is in .gitignore.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Strong random secret — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Encryption (AES-256-GCM for client secrets in DB) ─────────────────────────
# 64-char hex = 32 bytes = 256 bits — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX

# ── Admin API Key (protects /auth/sso/save and /auth/test-connection) ─────────
# generate with: node -e "console.log('zdna_' + require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=REPLACE_WITH_STRONG_API_KEY

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
CLIENT_URL=http://localhost:3000,http://localhost:5173,http://localhost:5175

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A — Individual vars (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sso_db
DB_USER=sso_user
DB_PASSWORD=sso_secret

# Option B — DATABASE_URL (Cloud Run + Cloud SQL via Unix socket)
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# Cloud Run: set DATABASE_URL only (overrides DB_* vars above)
# Cloud SQL instance connection name format: my-project:us-central1:sso-db

# Leave unset to use in-memory fallback (single instance / local dev)

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── OIDC Client Secrets (referenced as env:VAR_NAME in DB) ────────────────────
# Add one entry per company:
# OIDC_CLIENT_SECRET_<COMPANY>=your-azure-client-secret
OIDC_CLIENT_SECRET_ZDNA_123=REPLACE_WITH_AZURE_CLIENT_SECRET

# ── Feature Flags — Global Kill Switches ─────────────────────────────────────
# Set to "true" to disable for ALL companies instantly (no DB change needed)
# Useful for emergency shutdown or maintenance
# FEATURE_SSO_ENABLED_DISABLED=true
# FEATURE_JIT_ENABLED_DISABLED=true

# ── Frontend URL (OIDC redirect relay in dev mode) ────────────────────────────
FRONTEND_URL=http://localhost:3000
